---
source: xtask/src/css.rs
expression: tokens_css(&design)
---
/* Gerado por `cargo xtask css` a partir do DESIGN-scriba.md. Não editar. */

@theme static {
  --color-*: initial;
  --color-brand-ink: #000000;
  --color-primary: #0066cc;
  --color-primary-focus: #0071e3;
  --color-primary-on-dark: #2997ff;
  --color-on-primary: #ffffff;
  --color-link: #0066cc;
  --color-ink: #1d1d1f;
  --color-ink-secondary: #6e6e73;
  --color-ink-tertiary: #86868b;
  --color-on-dark: #ffffff;
  --color-on-dark-secondary: #a1a1a6;
  --color-canvas: #ffffff;
  --color-canvas-parchment: #f5f5f7;
  --color-surface-pearl: #fafafc;
  --color-surface-dark: #1d1d1f;
  --color-surface-black: #000000;
  --color-hairline: #e0e0e0;
  --color-divider-soft: #f0f0f0;
  --color-status-success: #116329;
  --color-status-success-bg: #e6f4ea;
  --color-status-warning: #7d4e00;
  --color-status-warning-bg: #fff4d6;
  --color-status-error: #d70015;
  --color-status-error-bg: #fde8ea;
  --color-recording: #ff3b30;
  --color-recording-bg: #ffebe9;
  --color-danger: #d70015;
  --font-sans: Inter, system-ui, sans-serif;
  --text-display: 40px;
  --text-display--line-height: 1.1;
  --text-display--letter-spacing: -0.4px;
  --text-display--font-weight: 600;
  --text-title: 28px;
  --text-title--line-height: 1.14;
  --text-title--letter-spacing: -0.3px;
  --text-title--font-weight: 600;
  --text-headline: 21px;
  --text-headline--line-height: 1.19;
  --text-headline--letter-spacing: -0.2px;
  --text-headline--font-weight: 600;
  --text-body: 17px;
  --text-body--line-height: 1.44;
  --text-body--letter-spacing: -0.374px;
  --text-body--font-weight: 400;
  --text-body-strong: 17px;
  --text-body-strong--line-height: 1.24;
  --text-body-strong--letter-spacing: -0.374px;
  --text-body-strong--font-weight: 600;
  --text-transcript: 17px;
  --text-transcript--line-height: 1.6;
  --text-transcript--letter-spacing: -0.2px;
  --text-transcript--font-weight: 400;
  --text-callout: 15px;
  --text-callout--line-height: 1.4;
  --text-callout--letter-spacing: -0.24px;
  --text-callout--font-weight: 400;
  --text-caption: 14px;
  --text-caption--line-height: 1.43;
  --text-caption--letter-spacing: -0.224px;
  --text-caption--font-weight: 400;
  --text-caption-strong: 14px;
  --text-caption-strong--line-height: 1.29;
  --text-caption-strong--letter-spacing: -0.224px;
  --text-caption-strong--font-weight: 600;
  --text-timestamp: 14px;
  --text-timestamp--line-height: 1.43;
  --text-timestamp--letter-spacing: 0;
  --text-timestamp--font-weight: 400;
  --text-footnote: 12px;
  --text-footnote--line-height: 1.33;
  --text-footnote--letter-spacing: -0.12px;
  --text-footnote--font-weight: 400;
  --radius-none: 0px;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --radius-icon: 22%;
  --radius-pill: 9999px;
  --spacing-xxs: 4px;
  --spacing-xs: 8px;
  --spacing-sm: 12px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  --spacing-xxl: 48px;
  --spacing-section: 64px;
  --motion-press-scale: 0.97;
  --motion-duration-fast: 150ms;
  --motion-duration-base: 250ms;
  --motion-easing: cubic-bezier(0.25, 0.1, 0.25, 1);
  --motion-recording-pulse: 1.6s;
  --shadow-floating: 0 8px 30px rgba(0, 0, 0, 0.12);
  --effect-backdrop: saturate(180%) blur(20px);
}

@layer base {
  :root {
    color-scheme: light;
  }
  [data-theme="dark"] {
    --color-primary: #0071e3;
    --color-primary-focus: #409cff;
    --color-link: #2997ff;
    --color-ink: #f5f5f7;
    --color-ink-secondary: #a1a1a6;
    --color-ink-tertiary: #6e6e73;
    --color-canvas: #1c1c1e;
    --color-canvas-parchment: #000000;
    --color-surface-pearl: #2c2c2e;
    --color-surface-dark: #2c2c2e;
    --color-hairline: #38383a;
    --color-divider-soft: #2c2c2e;
    --color-status-success: #30d158;
    --color-status-success-bg: #0f2e1a;
    --color-status-warning: #ffd60a;
    --color-status-warning-bg: #332a00;
    --color-status-error: #ff6961;
    --color-status-error-bg: #3a1214;
    --color-recording: #ff453a;
    --color-recording-bg: #3a1412;
    color-scheme: dark;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --color-primary: #0071e3;
      --color-primary-focus: #409cff;
      --color-link: #2997ff;
      --color-ink: #f5f5f7;
      --color-ink-secondary: #a1a1a6;
      --color-ink-tertiary: #6e6e73;
      --color-canvas: #1c1c1e;
      --color-canvas-parchment: #000000;
      --color-surface-pearl: #2c2c2e;
      --color-surface-dark: #2c2c2e;
      --color-hairline: #38383a;
      --color-divider-soft: #2c2c2e;
      --color-status-success: #30d158;
      --color-status-success-bg: #0f2e1a;
      --color-status-warning: #ffd60a;
      --color-status-warning-bg: #332a00;
      --color-status-error: #ff6961;
      --color-status-error-bg: #3a1214;
      --color-recording: #ff453a;
      --color-recording-bg: #3a1412;
      color-scheme: dark;
    }
  }
}

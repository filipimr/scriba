{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/rustfmt-file.ps1\"",
            "timeout": 30,
            "statusMessage": "rustfmt..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/rust-check.ps1\"",
            "timeout": 600,
            "statusMessage": "cargo fmt + clippy..."
          }
        ]
      }
    ]
  }
}
